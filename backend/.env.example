# Copy to backend/.env and edit. All variables are optional for DEMO MODE.
BIOQUEST_SECRET_KEY=change-me-to-a-long-random-string
BIOQUEST_CONTACT_EMAIL=you@example.org          # sent in the User-Agent to iNaturalist/GBIF (good API etiquette)
# BIOQUEST_DATABASE_URL=postgresql+psycopg://bioquest:bioquest@localhost:5432/bioquest
BIOQUEST_FRONTEND_ORIGIN=http://localhost:3000

# iNaturalist OAuth app (only needed for "Connect iNaturalist" + submitting observations)
# Create at https://www.inaturalist.org/oauth/applications/new  (redirect URI below must match)
BIOQUEST_INAT_CLIENT_ID=
BIOQUEST_INAT_CLIENT_SECRET=
BIOQUEST_INAT_REDIRECT_URI=http://localhost:8000/api/inat/oauth/callback

# Environmental layers for LIVE modelling: run scripts/download_worldclim.py first
BIOQUEST_ENV_PROVIDER=worldclim
# BIOQUEST_WORLDCLIM_DIR=./data/worldclim

# Storage: local (default) or s3
# BIOQUEST_STORAGE_BACKEND=s3
# BIOQUEST_S3_BUCKET=bioquest
# BIOQUEST_S3_ENDPOINT_URL=http://localhost:9000
